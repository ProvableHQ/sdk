{
  "name": "@provablehq/account-tools",
  "version": "0.1.1",
  "description": "Minimal TypeScript bindings for Aleo address operations",
  "collaborators": [
    "The Provable Team"
  ],
  "license": "GPL-3.0",
  "type": "module",
  "main": "./dist/node.js",
  "browser": "./dist/browser.js",
  "exports": {
    ".": {
      "node": "./dist/node.js",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "rimraf dist && rollup -c rollup.config.js",
    "test": "rimraf tmp && rollup -c rollup.test.js && mocha tmp/**/*.test.js --timeout 60000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProvableHQ/sdk.git"
