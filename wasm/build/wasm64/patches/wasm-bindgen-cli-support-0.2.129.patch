+
+#[test]
+fn memory64_thread_transform_preserves_high_addresses() -> Result<()> {
+    let wasm = wat::parse_str(
+        r#"(module
+      (import "env" "memory" (memory i64 65537 131072 shared))
+      (func (export "__wasm_init_tls") (param i64))
+      (func (export "__wbindgen_malloc") (param f64 f64) (result f64) f64.const 4295098368)
+      (func (export "__wbindgen_free") (param f64 f64 f64))
+      (global (export "__tls_size") i64 (i64.const 128))
+      (global (export "__tls_align") i64 (i64.const 8))
+      (global (export "__tls_base") (mut i64) (i64.const 0))
+      (global $__stack_pointer (mut i64) (i64.const 65536))
+    )"#,
+    )?;
+    let mut module = ModuleConfig::new().parse(&wasm)?;
+    assert!(super::run(&mut module)?.is_some());
+    unstart_start_function(&mut module);
+    let bytes = module.emit_wasm();
+    let features = wasmparser::WasmFeatures::default()
+        | wasmparser::WasmFeatures::THREADS
+        | wasmparser::WasmFeatures::MEMORY64;
+    wasmparser::Validator::new_with_features(features).validate_all(&bytes)?;
+    let printed = wasmprinter::print_bytes(&bytes)?;
+    assert!(printed.contains("i64.const 4295032832"));
+    assert!(printed.contains("i64.const 4295098368"));
+    Ok(())
 }
 
