 #[cfg(test)]
 mod tests;
+
+fn abi_value(memory64: bool, value: u64) -> Value {
+    if memory64 {
+        Value::F64(value as f64)
+    } else {
+        Value::I32(value as i32)
+    }
+}
+
+fn address_value(memory64: bool, value: u64) -> Value {
+    if memory64 {
+        Value::I64(value as i64)
+    } else {
+        Value::I32(value as i32)
+    }
+}
+
+fn abi_condition(body: &mut InstrSeqBuilder<'_>, memory64: bool) {
+    if memory64 {
+        body.f64_const(0.0).binop(walrus::ir::BinaryOp::F64Gt);
+    }
+}
