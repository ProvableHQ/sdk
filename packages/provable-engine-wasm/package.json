{
  "name": "@provablehq/provable-engine-wasm",
  "version": "0.1.0",
  "description": "WASM engine implementation for @provablehq/provablekit",
  "license": "GPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testnet.js": {
      "types": "./dist/testnet/index.d.ts",
      "default": "./dist/testnet/index.js"
    },
    "./mainnet.js": {
      "types": "./dist/mainnet/index.d.ts",
      "default": "./dist/mainnet/index.js"
    },
    "./worker.js": {
      "types": "./dist/testnet/worker.d.ts",
      "default": "./dist/testnet/worker.js"
    },
    "./testnet/worker.js": {
      "types": "./dist/testnet/worker.d.ts",
      "default": "./dist/testnet/worker.js"
    },
    "./mainnet/worker.js": {
      "types": "./dist/mainnet/worker.d.ts",
      "default": "./dist/mainnet/worker.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProvableHQ/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ProvableHQ/sdk/issues"
  },
  "homepage": "https://github.com/ProvableHQ/sdk/tree/mainnet/packages/provable-engine-wasm#readme",
  "scripts": {
    "build": "rimraf dist && node build-wasm.js && tsc -p tsconfig.json",
    "test": "node --test dist/**/*.test.js",
    "clean": "rimraf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@rollup/plugin-virtual": "^3.0.2",
    "@wasm-tool/rollup-plugin-rust": "^3.1.4",
    "@types/node": "^22.12.0",
    "binaryen": "^120.0.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.59.0",
    "typescript": "^5.7.3"
  }
}
