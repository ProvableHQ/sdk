{
  "name": "@provablehq/provablekit",
  "version": "0.1.0",
  "description": "Platform-agnostic core contracts and shared logic for Provable SDK engines",
  "license": "GPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testnet.js": {
      "types": "./dist/testnet.d.ts",
      "default": "./dist/testnet.js"
    },
    "./mainnet.js": {
      "types": "./dist/mainnet.d.ts",
      "default": "./dist/mainnet.js"
    },
    "./dynamic.js": {
      "types": "./dist/dynamic.d.ts",
      "default": "./dist/dynamic.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProvableHQ/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ProvableHQ/sdk/issues"
  },
  "homepage": "https://github.com/ProvableHQ/sdk/tree/mainnet/packages/provable-core#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/**/*.test.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@provablehq/provable-engine-wasm": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
