{
  "name": "@provablehq/provable-engine-react-native",
  "version": "0.1.0",
  "description": "React Native Nitro engine implementation for @provablehq/provablekit",
  "authors": "ProvableHQ",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "android",
    "scripts",
    "nitrogen",
    "src",
    "third_party",
    "dist",
    "build.rs",
    "Cargo.lock",
    "Cargo.toml",
    "nitro.json",
    "rust-toolchain.toml",
    "ProvableEngineReactNative.podspec",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProvableHQ/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ProvableHQ/sdk/issues"
  },
  "homepage": "https://github.com/ProvableHQ/sdk/tree/mainnet/packages/provable-engine-react-native#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/**/*.test.js",
    "clean": "rimraf dist",
    "specs": "nitrogen"
  },
  "dependencies": {
    "@scure/base": "^2.0.0",
    "react-native-nitro-modules": "0.35.0"
  },
  "peerDependencies": {
    "react-native": ">=0.76",
    "typescript": "^5"
  },
  "react-native": {
    "android": {
      "sourceDir": "./android"
    }
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
