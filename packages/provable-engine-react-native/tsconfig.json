{
  "include": [
    "src/index.ts",
    "src/index.test.ts",
    "src/nitro-core.ts",
    "src/native-bindings-nitro.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "outDir": "./dist",
    "target": "es2022",
    "module": "Node16",
    "lib": ["esnext", "dom"],
    "declaration": true,
    "sourceMap": true,
    "rootDir": "./src",
    "strict": true,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
