{
  "name": "sdk-root",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "sdk",
    "sdk-address",
    "wasm",
    "wasm-address",
    "website",
    "create-leo-app",
    "create-leo-app/*",
    "e2e",
    "e2e/*"
  ],
  "type": "module",
  "scripts": {
    "build:wasm": "rustup show active-toolchain && cd wasm && yarn build",
    "build:wasm-account-tools": "rustup show active-toolchain && cd wasm-address && yarn build",
    "build:sdk": "cd sdk && yarn build",
    "build:sdk-account-tools": "cd sdk-address && yarn build",
    "build:sdk-docs": "sh scripts/jsdoc.sh",
    "build:create-leo-app": "cd create-leo-app && yarn build",
    "build:all": "yarn build:wasm && yarn build:wasm-address && yarn build:sdk && yarn build:sdk-address && yarn build:create-leo-app",
    "start:website": "cd website && yarn dev",
    "test:wasm": "cd wasm && yarn test",
    "test:sdk": "cd sdk && yarn test",
    "test": "yarn test:wasm && yarn test:sdk",
    "change-version": "node scripts/change-version.js",
    "deploy:wasm": "cd wasm && npm publish --access=public",
    "deploy:wasm-accounts-tools": "cd wasm-address && npm publish --access=public",
    "deploy:sdk": "cd sdk && npm publish --access=public",
    "deploy:sdk-account-tools": "cd sdk-address && npm publish --access=public",
    "deploy:create-leo-app": "cd create-leo-app && npm publish --access=public",
    "deploy": "yarn build:all && yarn deploy:wasm && yarn deploy:wasm-address && yarn deploy:sdk && yarn deploy:sdk-address && yarn deploy:create-leo-app",
    "lint": "prettier . --check",
    "pretty": "prettier . --write"
  },
  "optionalDependencies": {
    "glob": "^11.0.1"
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "wasm-pack": "^0.13.1"
  }
}
