{
  "name": "sdk-root",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "website",
    "create-leo-app",
    "e2e"
  ],
  "type": "module",
  "scripts": {
    "build:packages": "yarn workspace @provablehq/provable-engine-wasm build && yarn workspace @provablehq/provablekit build && yarn workspace @provablehq/provable-engine-react-native build",
    "build:create-leo-app": "cd create-leo-app && yarn build",
    "build:all": "yarn build:packages && yarn build:create-leo-app",
    "build:all-debug": "yarn build:packages && yarn build:create-leo-app",
    "start:website": "cd website && yarn dev",
    "test:packages": "yarn workspace @provablehq/provablekit test && yarn workspace @provablehq/provable-engine-wasm test && yarn workspace @provablehq/provable-engine-react-native test",
    "test:migration-guards": "node scripts/migration-guards.mjs",
    "test": "yarn test:packages && yarn test:migration-guards",
    "change-version": "node scripts/change-version.js",
    "deploy:provablekit": "cd packages/provable-core && npm publish --access=public",
    "deploy:provable-engine-wasm": "cd packages/provable-engine-wasm && npm publish --access=public",
    "deploy:provable-engine-react-native": "cd packages/provable-engine-react-native && npm publish --access=public",
    "deploy:create-leo-app": "cd create-leo-app && npm publish --access=public",
    "deploy": "yarn build:all && yarn deploy:provablekit && yarn deploy:provable-engine-wasm && yarn deploy:provable-engine-react-native && yarn deploy:create-leo-app",
    "lint": "prettier . --check",
    "pretty": "prettier . --write"
  },
  "optionalDependencies": {
    "glob": "^11.0.1"
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "wasm-pack": "^0.13.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
