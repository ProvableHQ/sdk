{
    "compilerOptions": {
        /* Basic Options */
        "target": "es2017",
        "module": "esnext",
        "rootDir": "./src",
        "types": ["node"],

        /* Module Resolution Options */
        "moduleResolution": "bundler",
        "esModuleInterop": true,

        /* Advanced Options */
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    }
}
