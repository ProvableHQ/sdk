# Aleo Loyalty Program (React) - Environment Configuration
# Copy this file to .env and fill in your values.
# Vite automatically loads .env files - no additional setup needed.
# Variables must be prefixed with VITE_ to be available in the browser.

# =============================================================================
# Provable API Consumer ID
# =============================================================================
# Single consumer ID used for both DPS (proving) and RSS (record scanning).
VITE_ALEO_CONSUMER_ID=your-consumer-id-here

# =============================================================================
# Proving Mode
# =============================================================================
# "local" (default) - Prove on this machine. Works with any program.
# "delegated" - Offload proving to a remote service. Requires deployed program.
VITE_ALEO_PROVING_MODE=local

# =============================================================================
# Delegated Proving Service (DPS)
# Required when: VITE_ALEO_PROVING_MODE=delegated
# =============================================================================
# DPS URL (include the network suffix: /testnet or /mainnet).
VITE_ALEO_DPS_URL=https://api.provable.com/prove/testnet

# API key for authentication.
VITE_ALEO_DPS_API_KEY=your-api-key-here

# Optional: Enable TEE-encrypted proving requests.
# VITE_ALEO_DPS_PRIVACY=true

# =============================================================================
# Record Scanning Service (RSS)
# Uses dedicated indexing service for faster record discovery.
# =============================================================================
# RSS URL (without network suffix - SDK adds /testnet or /mainnet automatically).
VITE_ALEO_RSS_URL=https://api.provable.com/scanner

# Block height to start scanning from (default: 0).
# Set this higher to skip older blocks and speed up scanning.
# VITE_ALEO_SCAN_START_HEIGHT=0

# Or provide a JWT token directly (starts with "eyJ...").
# VITE_ALEO_RSS_API_KEY=eyJ...
